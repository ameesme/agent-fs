# CLI chat is included by default. Optional background channel:
# CHANNEL_COMMAND=sh /channels/telegram.sh

# Telegram
# Token from @BotFather, then the chat ids allowed to drive the main
# TELEGRAM_BOT_TOKEN=
# Optional dedicated chat bot; takes precedence over TELEGRAM_BOT_TOKEN.
# TELEGRAM_CHAT_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
