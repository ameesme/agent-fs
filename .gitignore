.env
.env.*
!.env.example
.DS_Store

# Keep included agents; ignore their generated files.
/data/*
!/data/agents/
/data/agents/*
!/data/agents/main/
!/data/agents/poem/
!/data/agents/code/
/data/agents/*/*
!/data/agents/*/Dockerfile
!/data/agents/*/agent.json
!/data/agents/*/soul.md
!/data/agents/*/cron/
!/data/agents/*/.env.example
!/data/agents/main/skills/

# Keep shared defaults and skills; ignore shared runtime data.
!/data/shared/
/data/shared/*
!/data/shared/.env.example
!/data/shared/skills/
