#!/bin/sh
set -eu

dir=${1:?usage: newtask <kanban-dir> <title>   (task body on stdin)}
title=${2:?usage: newtask <kanban-dir> <title>   (task body on stdin)}

id="task-$(date -u +%Y%m%d-%H%M%S)-$$"
tmp="$dir/.$id.md.tmp"

{
  echo '---'
  echo "id: $id"
  echo "created: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "created_by: ${AGENT_NAME:-mees}"
  echo "priority: ${PRIORITY:-normal}"
  [ -n "${PARENT:-}" ] && echo "parent: $PARENT"
  [ -n "${GROUP:-}" ] && echo "group: $GROUP"
  echo '---'
  echo "# $title"
  echo
  cat
} > "$tmp"

mv "$tmp" "$dir/$id.md"
echo "$dir/$id.md"
